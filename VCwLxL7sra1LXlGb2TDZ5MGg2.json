c/li\u003e\n\u003c/ul\u003e\n\u003cul\u003e\n\u003cli style=\"list-style-type: none;\"\u003e\n\u003cul\u003e\n\u003cli dir=\"ltr\" aria-level=\"2\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eVendor: Fortinet\u003c/p\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\" aria-level=\"2\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003ePriority: High\u003c/p\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\" aria-level=\"2\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eGo to the Integrations tab and add a Firewall system following:\u003c/p\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\" aria-level=\"2\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eSave configurations and verify connections.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp dir=\"ltr\"\u003e\u003cstrong\u003eExercise Verification:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli dir=\"ltr\" aria-level=\"1\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eConfirm that the configured fw integrations appear in the FW Integration list.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e","order":0,"title":"Exercise 1: System Setup and Initial Configuration","estimatedTimeMinutes":10,"lastUpdateTime":"Wed, 19 Feb 2025 16:38:28 GMT","checkpoint":{"imgPath":"ad67cbe6-c2e3-435f-8bb6-a60dc5a5a9ad.png","areas":[{"topLeft":{"x":378,"y":846},"bottomRight":{"x":487,"y":879}},{"topLeft":{"x":552,"y":847},"bottomRight":{"x":662,"y":879}}],"hint":null,"guidedJourneySectionId":"JSwriqinFIDygVGRl9Sbn02A2","lastUpdateTime":"Mon, 01 Jan 1753 00:00:00 GMT","learnRequestId":"LRX9PzMx3j3cvpeIl6GsVm7Q2","allowFailedCheck":null,"enableHint":false,"id":"CPnEG-62uf2ibNsMjdA3n1HA2"},"checkpointId":"CPnEG-62uf2ibNsMjdA3n1HA2","checkpointHint":null,"enableCheckpointHint":false,"allowCheckpointFailedCheck":null,"checkpointImgUrl":null,"correlationId":8285113296014913281,"id":"JSwriqinFIDygVGRl9Sbn02A2"},{"content":"\u003cp dir=\"ltr\"\u003e\u003cstrong\u003eObjective: \u003c/strong\u003e\u003cstrong\u003eSet up threat intelligence and configure anomaly detection thresholds\u003c/strong\u003e.\u003c/p\u003e\n\u003cul\u003e\n\u003cli dir=\"ltr\" aria-level=\"1\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eActivate Threat Intelligence Feeds:\u003c/p\u003e\n\u003c/li\u003e\n\u003cul\u003e\n\u003cli dir=\"ltr\" aria-level=\"2\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eThreat Intelligence Feed Name:\u0026nbsp; Threat Feed 1\u003c/p\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\" aria-level=\"2\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eURL:\u003ca href=\"https://example-feed1.com/api\"\u003e https://example-feed1.com/api\u003c/a\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\" aria-level=\"2\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eUpdate Frequency: Every 15 minutes\u003c/p\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\" aria-level=\"2\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eUnder Threat Intelligence, add Threat Intelligence Feed:\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/ul\u003e\n\u003cp dir=\"ltr\"\u003e\u003cstrong\u003eExercise Verification:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eEnsure the Threat Intelligence section shows real-time updates from your added\u0026nbsp; feeds.\u003cstrong id=\"docs-internal-guid-d783ff70-7fff-f187-478e-ca0569386641\"\u003e\u003cbr\u003e\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e","order":1,"title":"Exercise 2: Configuring Threat Intelligence and Anomaly Detection","estimatedTimeMinutes":10,"lastUpdateTime":"Mon, 01 Jan 1753 00:00:00 GMT","checkpoint":null,"checkpointId":null,"checkpointHint":null,"enableCheckpointHint":null,"allowCheckpointFailedCheck":null,"checkpointImgUrl":null,"correlationId":6147143115429560265,"id":"JSaXaMtD3UwVHJOpuyuDRBKA2"},{"content":"\u003cp dir=\"ltr\"\u003e\u003cstrong\u003eObjective: \u003c/strong\u003e\u003cstrong\u003eCreate a compliance report and verify adherence to regulatory standards.\u003c/strong\u003e\u003c/p\u003e\n\u003col\u003e\n\u003cli dir=\"ltr\" aria-level=\"1\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eAccess Compliance Settings:\u003c/p\u003e\n\u003c/li\u003e\n\u003cul\u003e\n\u003cli dir=\"ltr\" aria-level=\"2\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eGo to Compliance \u0026gt; Settings and select a compliance framework (e.g., GDPR or HIPAA).\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cli dir=\"ltr\" aria-level=\"1\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eRun a Compliance Check:\u003c/p\u003e\n\u003c/li\u003e\n\u003cul\u003e\n\u003cli dir=\"ltr\" aria-level=\"2\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eRun a compliance check across the network.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\" aria-level=\"2\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eReview any gaps or non-compliant areas identified by Security Vision .\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cli dir=\"ltr\" aria-level=\"1\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eGenerate a Compliance Report:\u003c/p\u003e\n\u003c/li\u003e\n\u003cul\u003e\n\u003cli dir=\"ltr\" aria-level=\"2\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eGenerate and export a report on network compliance.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\" aria-level=\"2\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eVerify that the report includes data on all detected threats and current compliance status.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/ol\u003e\n\u003cp dir=\"ltr\"\u003e\u003cstrong\u003eExercise Verification:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli dir=\"ltr\" aria-level=\"1\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eEnsure the compliance report is downloaded and that you can interpret gaps identified by Security Vision .\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e","order":2,"title":"Exercise 3: Compliance and Reporting","estimatedTimeMinutes":10,"lastUpdateTime":"Wed, 19 Feb 2025 16:38:28 GMT","checkpoint":{"imgPath":"ee9ac10c-9864-4738-a062-4ef16480eb4d.png","areas":[{"topLeft":{"x":214,"y":300},"bottomRight":{"x":912,"y":681}},{"topLeft":{"x":921,"y":303},"bottomRight":{"x":1145,"y":538}}],"hint":null,"guidedJourneySectionId":"JStSomUfzk3yrcsCdGI_Oaqw2","lastUpdateTime":"Mon, 01 Jan 1753 00:00:00 GMT","learnRequestId":"LRWFQvrScfqsCPZUOl8fgsew2","allowFailedCheck":null,"enableHint":false,"id":"CPGonJW43aChRNpS7Ank5RLw2"},"checkpointId":"CPGonJW43aChRNpS7Ank5RLw2","checkpointHint":null,"enableCheckpointHint":false,"allowCheckpointFailedCheck":null,"checkpointImgUrl":null,"correlationId":1589272217825735097,"id":"JStSomUfzk3yrcsCdGI_Oaqw2"},{"content":"\u003cp dir=\"ltr\"\u003e\u003cstrong\u003eObjective: Use Security Vision to monitor, detect, and respond to a simulated active threat.\u003c/strong\u003e\u003c/p\u003e\n\u003col\u003e\n\u003cli dir=\"ltr\" aria-level=\"1\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eSimulate a Threat:\u003c/p\u003e\n\u003cul\u003e\n\u003cli dir=\"ltr\" aria-level=\"2\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eRun a simulated DDoS attack or port scan against a sample network.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\" aria-level=\"2\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eObserve how the dashboard identifies the threat.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\" aria-level=\"1\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eView and Analyze Threat Information:\u003c/p\u003e\n\u003cul\u003e\n\u003cli dir=\"ltr\" aria-level=\"2\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eGo to Threat Overview to review the active threat.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\" aria-level=\"2\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eCheck the Source IP, Destination, and Severity Score.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\" aria-level=\"2\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eIdentify threat origin and patterns through the Threat Map view.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\" aria-level=\"1\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eSet Real-Time Monitoring Alerts:\u003c/p\u003e\n\u003cul\u003e\n\u003cli dir=\"ltr\" aria-level=\"2\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eEnable real-time alerts for similar activity in Alert Settings.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003e\u003cstrong\u003eExercise Verification:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli dir=\"ltr\" aria-level=\"1\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eVerify that the Threat Overview displays real-time information.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\" aria-level=\"1\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eEnsure alert configurations are properly set up for similar future threats.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e","order":3,"title":"Exercise 4: Monitoring Real-Time Threats","estimatedTimeMinutes":10,"lastUpdateTime":"Mon, 01 Jan 1753 00:00:00 GMT","checkpoint":null,"checkpointId":null,"checkpointHint":null,"enableCheckpointHint":null,"allowCheckpointFailedCheck":null,"checkpointImgUrl":null,"correlationId":1933731335358133879,"id":"JSEob7bW1cSJlpVweo-f4sIQ2"},{"content":"\u003cp dir=\"ltr\"\u003e\u003cstrong\u003eObjective: Trigger, analyze, and respond to a security incident using Security Vision ’s incident response feature.\u003c/strong\u003e\u003c/p\u003e\n\u003col\u003e\n\u003cli dir=\"ltr\" aria-level=\"1\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eTrigger an Incident:\u003c/p\u003e\n\u003c/li\u003e\n\u003cul\u003e\n\u003cli dir=\"ltr\" aria-level=\"2\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eRun a mock attack script, such as an unauthorized data exfiltration attempt.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\" aria-level=\"2\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eObserve the alert generated in Incident Response.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cli dir=\"ltr\" aria-level=\"1\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eAnalyze the Incident:\u003c/p\u003e\n\u003c/li\u003e\n\u003cul\u003e\n\u003cli dir=\"ltr\" aria-level=\"2\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eReview details on the incident page, noting the attacker’s IP, affected data, and threat score.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cli dir=\"ltr\" aria-level=\"1\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eInitiate Automated Remediation:\u003c/p\u003e\n\u003c/li\u003e\n\u003cul\u003e\n\u003cli dir=\"ltr\" aria-level=\"2\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eIn Response Actions, configure Security Vision to block the attacker’s IP and quarantine the affected assets.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\" aria-level=\"2\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eSet an automated response for future similar incidents.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/ol\u003e\n\u003cp dir=\"ltr\"\u003e\u003cstrong\u003eExercise Verification:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli dir=\"ltr\" aria-level=\"1\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eConfirm that the incident was contained, with attacker IP blocked and affected assets isolated.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e","order":4,"title":"Exercise 5: Incident Response and Automated Remediation","estimatedTimeMinutes":10,"lastUpdateTime":"Mon, 01 Jan 1753 00:00:00 GMT","checkpoint":null,"checkpointId":null,"checkpointHint":null,"enableCheckpointHint":null,"allowCheckpointFailedCheck":null,"checkpointImgUrl":null,"correlationId":1860143301688570082,"id":"JSsKhE-KlWCXEEA9bK7nFjHA2"},{"content":"\u003cp dir=\"ltr\"\u003e\u003cstrong\u003eObjective: Understand how to configure and manage firewall rules to secure a network from unauthorized access.\u003c/strong\u003e\u003c/p\u003e\n\u003col\u003e\n\u003cli dir=\"ltr\" aria-level=\"1\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eSetup the Environment:\u003c/p\u003e\n\u003c/li\u003e\n\u003col\u003e\n\u003cli dir=\"ltr\" aria-level=\"2\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eLaunch a virtual environment with a network simulator (e.g., GNS3, Cisco Packet Tracer) or use a cloud-based firewall like AWS Security Groups.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\" aria-level=\"2\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eCreate a basic network with two subnets:\u003c/p\u003e\n\u003c/li\u003e\n\u003cul\u003e\n\u003cli dir=\"ltr\" aria-level=\"3\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eSubnet A (Internal): Hosts internal services.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\" aria-level=\"3\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eSubnet B (External): Represents external users or threats.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/ol\u003e\n\u003cli dir=\"ltr\" aria-level=\"1\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eCreate Basic Rules:\u003c/p\u003e\n\u003c/li\u003e\n\u003col\u003e\n\u003cli dir=\"ltr\" aria-level=\"2\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eAllow HTTP and HTTPS traffic to a web server in Subnet A from Subnet B.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\" aria-level=\"2\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eBlock all traffic to the database server except from Subnet A.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ol\u003e\n\u003c/ol\u003e\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e","order":5,"title":"Exercise 6: Understand Firewall Rules","estimatedTimeMinutes":10,"lastUpdateTime":"Mon, 01 Jan 1753 00:00:00 GMT","checkpoint":null,"checkpointId":null,"checkpointHint":null,"enableCheckpointHint":null,"allowCheckpointFailedCheck":null,"checkpointImgUrl":null,"correlationId":3758541922850423766,"id":"JSYEaOcwC7Rilr-U8QWl5jfw2"},{"content":"\u003cp dir=\"ltr\"\u003e\u003cstrong\u003eObjective: Learn to securely manage user credentials and protect passwords using encryption and hashing techniques.\u003c/strong\u003e\u003c/p\u003e\n\u003col\u003e\n\u003cli dir=\"ltr\" aria-level=\"1\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eSetup the Application:\u003c/p\u003e\n\u003c/li\u003e\n\u003cul\u003e\n\u003cli dir=\"ltr\" aria-level=\"2\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eUse a pre-configured web application or a simple Python/Node.js app with a login system.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cli dir=\"ltr\" aria-level=\"1\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eImplement Hashing:\u003c/p\u003e\n\u003c/li\u003e\n\u003cul\u003e\n\u003cli dir=\"ltr\" aria-level=\"2\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eReplace plaintext password storage with hashed passwords using libraries such as bcrypt or Argon2.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\" aria-level=\"2\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eSalts should be used to ensure unique hashes.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cli dir=\"ltr\" aria-level=\"1\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eTest Security:\u003c/p\u003e\n\u003c/li\u003e\n\u003cul\u003e\n\u003cli dir=\"ltr\" aria-level=\"2\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eAttempt to register users with identical passwords and verify that hashes differ due to salting.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli dir=\"ltr\" aria-level=\"2\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eTry to crack the hashes using common tools like Hashcat and observe the difficulty.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cli dir=\"ltr\" aria-level=\"1\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eIntegrate Multi-Factor Authentication (MFA):\u003c/p\u003e\n\u003c/li\u003e\n\u003cul\u003e\n\u003cli dir=\"ltr\" aria-level=\"2\"\u003e\n\u003cp dir=\"ltr\" role=\"presentation\"\u003eAdd an MFA layer to the application using a tool like Google Authenticator or SMS-based OTP.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/ol\u003e\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e","order":6,"title":"Exercise 7: Learn How To Manage User Credentials","estimatedTimeMinutes":10,"lastUpdateTime":"Mon, 01 Jan 1753 00:00:00 GMT","checkpoint":null,"checkpointId":null,"checkpointHint":null,"enableCheckpointHint":null,"allowCheckpointFailedCheck":null,"checkpointImgUrl":null,"correlationId":3394398048004081493,"id":"JSYIxSpA7MkIffEuRGcT89Lw2"}],"lastUpdateTime":"Mon, 01 Jan 1753 00:00:00 GMT","correlationId":1051292803571037586,"id":"CHEiVG4ptQJbDyWk2ngg4iig2"}],"checkpointCheckTimeoutInSeconds":60,"checkpointCheckPollingInSeconds":5,"id":"CTHMT78xnY5Gw7bPyTXYbjxw2"}}