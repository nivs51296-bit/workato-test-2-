,"id":"CToTDZ6OXB50j6kotLM2DTlw2"}],"defaultTabsContent":[],"defaultPageToken":"","defaultRdpSoundConfig":"Disabled","advancedGeneralSettings":{"defaultTabId":"CTdwoT7fFFcql6WCRdU3dppQ2","slackSettings":{"isEnabled":null,"channelId":null}},"slackSettingsContent":null,"brandingData":{"brandingColor":"#588923","logoPath":"CNBRHnrSIORXuZQdWv5O2AkQ2/PRUvah6blCIyRjUTSgraZeIg2/COo3pU3c5WtLtx9Lmv7URWAQ2_20251210114148.png","logoFileName":"Group 1 (1).png","logoLink":null},"endUserLogin":{"title":"Eric Test Lab 1","subtitle":"Enter your email and passphrase","enableTitle":true,"enableSubtitle":false,"enableBanner":true,"bannerPathHash":"CNBRHnrSIORXuZQdWv5O2AkQ2/PRUvah6blCIyRjUTSgraZeIg2/COo3pU3c5WtLtx9Lmv7URWAQ2_20251223130747.jpg","bannerFilename":"unnamed.jpg"},"fullscreenLandingState":false,"guidedJourney":{"chapters":[{"name":"Chapter 1 - Initial Environment Access","chapterOrder":0,"sections":[{"content":"\u003chead\u003e\u003c/head\u003e\u003cbody\u003e\u003cp\u003eFollow these instructions:\u003c/p\u003e\n\n\n\n\n\u003cul\u003e\n\u003cli\u003eIn the CloudShare environment console, locate the \u003cstrong\u003eDevServer\u003c/strong\u003e VM.\u003c/li\u003e\n\u003cli\u003eClick the \u003cstrong\u003eConnect\u003c/strong\u003e button (RDP or Console).\u003c/li\u003e\n\u003cli\u003eLog in using the provided \u003ccode\u003eAdministrator\u003c/code\u003e credentials (found in the \u003cstrong\u003eCredentials Tab\u003c/strong\u003e).\u003c/li\u003e\n\u003c/ul\u003e\n\n\n\n\n\u003c/body\u003e","order":0,"title":"Section 1.1 - Connect to the Primary DevServer","estimatedTimeMinutes":10,"lastUpdateTime":"Mon, 01 Jan 1753 00:00:00 GMT","checkpoint":null,"checkpointId":null,"checkpointHint":null,"enableCheckpointHint":null,"allowCheckpointFailedCheck":null,"checkpointImgUrl":null,"correlationId":7841758768454188819,"id":"JSxDTVVi4tkPSlGVl4XUFlQw2"},{"content":"\u003chead\u003e\u003c/head\u003e\u003cbody\u003e\u003cp\u003eThis step ensures the \u003cstrong\u003eDevServer\u003c/strong\u003e can communicate with the backend database machine.\u003c/p\u003e\n\n\n\n\n\u003cul\u003e\n\u003cli\u003eOn \u003cstrong\u003eDevServer\u003c/strong\u003e, open \u003cstrong\u003eCommand Prompt\u003c/strong\u003e or \u003cstrong\u003ePowerShell\u003c/strong\u003e.\u003c/li\u003e\n\u003cli\u003eAttempt to ping the database server by its hostname:\u003cpre\u003e\u003ccode class=\"language-bash\"\u003eping DBC-01\n\u003c/code\u003e\u003c/pre\u003e\n\u003c/li\u003e\n\u003cli\u003eYou should receive a successful reply. If you do not, check that both VMs are running.\u003c/li\u003e\n\u003c/ul\u003e\n\n\n\n\n\u003c/body\u003e","order":1,"title":"Section 1.2 - Verify Network PING","estimatedTimeMinutes":10,"lastUpdateTime":"Mon, 01 Jan 1753 00:00:00 GMT","checkpoint":null,"checkpointId":null,"checkpointHint":null,"enableCheckpointHint":null,"allowCheckpointFailedCheck":null,"checkpointImgUrl":null,"correlationId":8545694839938710883,"id":"JSVOiw4PIbR5iO2qDJR3Wa_Q2"}],"lastUpdateTime":"Mon, 01 Jan 1753 00:00:00 GMT","correlationId":7527148053044275494,"id":"CHPw0rlZ-wSjlY4i-HYuNz2A2"},{"name":"Chapter 2 - Project Dependencies and Setup","chapterOrder":1,"sections":[{"content":"\u003chead\u003e\u003c/head\u003e\u003cbody\u003e\u003cp\u003eWe require \u003cstrong\u003eNode.js v18\u003c/strong\u003e for the starter project.\u003c/p\u003e\n\n\n\n\n\u003cp\u003eFollow these instructions:\u003c/p\u003e\n\n\n\n\n\u003cul\u003e\n\u003cli\u003eOpen the pre-installed web browser on \u003cstrong\u003eDevServer\u003c/strong\u003e.\u003c/li\u003e\n\u003cli\u003eNavigate to the official Node.js download page and download the \u003cstrong\u003eLTS Windows Installer (.msi)\u003c/strong\u003e.\u003c/li\u003e\n\u003cli\u003eRun the installer, accepting all default settings.\u003c/li\u003e\n\u003cli\u003eVerify the installation in \u003cstrong\u003ePowerShell\u003c/strong\u003e:\u003cpre\u003e\u003ccode class=\"language-bash\"\u003enode -v\nnpm -v\n\u003c/code\u003e\u003c/pre\u003e\n  \u003cem\u003eExpected output:\u003c/em\u003e $v18.x.x$ and $9.x.x$\u003c/li\u003e\n\u003c/ul\u003e\n\n\n\n\n\u003c/body\u003e","order":0,"title":"Section 2.1 - Install Node.js Dependency","estimatedTimeMinutes":10,"lastUpdateTime":"Mon, 01 Jan 1753 00:00:00 GMT","checkpoint":null,"checkpointId":null,"checkpointHint":null,"enableCheckpointHint":null,"allowCheckpointFailedCheck":null,"checkpointImgUrl":null,"correlationId":721409469364076928,"id":"JSqa-nvQpTaaURcsqgfvXQUQ2"},{"content":"\u003chead\u003e\u003c/head\u003e\u003cbody\u003e\u003cul\u003e\n\u003cli\u003eOpen \u003cstrong\u003eGit Bash\u003c/strong\u003e or \u003cstrong\u003ePowerShell\u003c/strong\u003e.\u003c/li\u003e\n\u003cli\u003eNavigate to the working directory:\u003cpre\u003e\u003ccode class=\"language-bash\"\u003ecd C:\\Users\\Administrator\\Desktop\n\u003c/code\u003e\u003c/pre\u003e\n\u003c/li\u003e\n\u003cli\u003eClone the project repository:\u003cpre\u003e\u003ccode class=\"language-bash\"\u003egit clone [https://github.com/your-org/starter-app.git](https://github.com/your-org/starter-app.git)\n\u003c/code\u003e\u003c/pre\u003e\n\u003c/li\u003e\n\u003cli\u003eNavigate into the new directory and install dependencies:\u003cpre\u003e\u003ccode class=\"language-bash\"\u003ecd starter-app\nnpm install\n\u003c/code\u003e\u003c/pre\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\n\n\n\n\u003c/body\u003e","order":1,"title":"Section 2.2 - Clone and Install Project","estimatedTimeMinutes":10,"lastUpdateTime":"Mon, 01 Jan 1753 00:00:00 GMT","checkpoint":null,"checkpointId":null,"checkpointHint":null,"enableCheckpointHint":null,"allowCheckpointFailedCheck":null,"checkpointImgUrl":null,"correlationId":3402374142016756479,"id":"JSkXfAB_3jGs_w2x1QYhzIEQ2"}],"lastUpdateTime":"Mon, 01 Jan 1753 00:00:00 GMT","correlationId":8075915650977953745,"id":"CHYZTCdxeT7CYlT0UOmpXRdw2"},{"name":"Chapter 3 - Initial Environment Access","chapterOrder":2,"sections":[{"content":"\u003chead\u003e\u003c/head\u003e\u003cbody\u003e\u003cp\u003eYour environment is successfully configured.\u003c/p\u003e\n\n\n\n\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eJourney Complete!\u003c/strong\u003e You have finished the initial setup.\u003c/li\u003e\n\u003cli\u003eNext Task: Please proceed to the \u003cstrong\u003e\"Building the API\"\u003c/strong\u003e Experience.\u003c/li\u003e\n\u003c/ul\u003e\n\n\u003c/body\u003e","order":0,"title":"Section 3.1 - finish up","estimatedTimeMinutes":10,"lastUpdateTime":"Mon, 01 Jan 1753 00:00:00 GMT","checkpoint":null,"checkpointId":null,"checkpointHint":null,"enableCheckpointHint":null,"allowCheckpointFailedCheck":null,"checkpointImgUrl":null,"correlationId":1287948945910079803,"id":"JStj0JNxGmYaeM2Di6mzMSbg2"}],"lastUpdateTime":"Mon, 01 Jan 1753 00:00:00 GMT","correlationId":5090308430889703706,"id":"CHkDiNwDW4wdCBeIt1Zoi0eg2"}],"checkpointCheckTimeoutInSeconds":60,"checkpointCheckPollingInSeconds":5,"id":"CT3U2WFJ2TsTHb1yhRRqjtHg2"}}